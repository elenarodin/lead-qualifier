# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key (sk-ant-...)
ANTHROPIC_API_KEY=

# Shared secret a new user sends to the bot to register themselves.
# Treat it as a password — anyone who knows it can use the bot.
# Pick something unguessable. Rotate by changing this value and removing
# rows from the authorized_users table for users who should lose access.
ACCESS_CODE=

# SQLite file location (default ./data/qualifier.db)
DB_PATH=./data/qualifier.db

# Log level: debug | info | warn | error (default info)
LOG_LEVEL=info
